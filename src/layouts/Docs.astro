---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  slug: string;
  source: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, slug, source, headings } = Astro.props;

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const href = (id: string) => (id === 'index' ? '/docs' : `/docs/${id}`);
const sections = [...new Set(docs.map((d) => d.data.section))].map((name) => ({
  name, items: docs.filter((d) => d.data.section === name),
}));
const i = docs.findIndex((d) => d.id === slug);
const prev = docs[i - 1];
const next = docs[i + 1];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const url = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description,
    url, inLanguage: 'en', author: { '@type': 'Person', name: SITE.author },
    about: { '@type': 'SoftwareSourceCode', name: 'semii', codeRepository: SITE.repo },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Docs', item: new URL('/docs', Astro.site).toString() },
      ...(slug === 'index' ? [] : [{ '@type': 'ListItem', position: 3, name: title, item: url }]),
    ],
  },
];
---

<Base title={slug === 'index' ? 'Documentation' : `${title} — Docs`} description={description} type="article" jsonLd={jsonLd}>
  <div class="container docs">
    <details class="side-mobile">
      <summary>Docs menu</summary>
      <nav aria-label="Documentation">
        {sections.map((s) => (
          <div><h2>{s.name}</h2><ul>{s.items.map((d) => <li><a href={href(d.id)} aria-current={d.id === slug ? 'page' : undefined}>{d.data.title}</a></li>)}</ul></div>
        ))}
      </nav>
    </details>

    <aside class="side" aria-label="Documentation">
      <nav>
        {sections.map((s) => (
          <div><h2>{s.name}</h2><ul>{s.items.map((d) => <li><a href={href(d.id)} aria-current={d.id === slug ? 'page' : undefined}>{d.data.title}</a></li>)}</ul></div>
        ))}
      </nav>
    </aside>

    <article class="doc">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/docs">Docs</a>{slug !== 'index' && <> / <span>{title}</span></>}</nav>
      <h1>{slug === 'index' ? 'semii documentation' : title}</h1>
      <div class="prose"><slot /></div>
      <div class="edit"><a href={`${SITE.repo}/blob/main/${source}`} rel="noopener">Edit this page on GitHub</a></div>
      <nav class="pager" aria-label="Previous and next">
        {prev ? <a class="card" href={href(prev.id)}><span>Previous</span>{prev.data.title}</a> : <span />}
        {next && <a class="card next" href={href(next.id)}><span>Next</span>{next.data.title}</a>}
      </nav>
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <h2>On this page</h2>
        <ul>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 230px minmax(0, 1fr) 210px; gap: 44px; padding-top: 36px; padding-bottom: 40px; }
  .side, .toc { position: sticky; top: 92px; align-self: start; max-height: calc(100vh - 110px); overflow-y: auto; }
  .side h2, .toc h2, .side-mobile h2 { font-family: var(--font-sans); font-size: 12.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 18px 0 8px; }
  .side ul, .toc ul, .side-mobile ul { list-style: none; padding: 0; margin: 0; }
  .side a, .side-mobile a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--text-soft); font-size: 15px; }
  .side a:hover, .side-mobile a:hover { background: var(--surface); text-decoration: none; color: var(--text); }
  .side a[aria-current='page'], .side-mobile a[aria-current='page'] { background: var(--surface-2); color: var(--text); box-shadow: inset 2px 0 0 var(--ember); }
  .toc a { display: block; padding: 4px 0; color: var(--muted); font-size: 14px; }
  .toc a:hover { color: var(--text); }
  .toc .d3 a { padding-left: 12px; font-size: 13.5px; }
  .doc { min-width: 0; }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 10px; }
  .doc h1 { font-size: clamp(32px, 4vw, 46px); margin-bottom: 26px; }
  .edit { margin: 34px 0 18px; font-size: 14.5px; }
  .pager { display: flex; justify-content: space-between; gap: 14px; }
  .pager a { flex: 1; max-width: 48%; padding: 14px 18px; color: var(--text); font-weight: 600; }
  .pager a:hover { border-color: var(--ember); text-decoration: none; }
  .pager span { display: block; font-size: 12.5px; color: var(--muted); font-weight: 500; }
  .pager .next { text-align: right; margin-left: auto; }
  .side-mobile { display: none; }
  @media (max-width: 1180px) { .docs { grid-template-columns: 220px minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 820px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .side { display: none; }
    .side-mobile { display: block; border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; background: var(--surface); }
    .side-mobile summary { cursor: pointer; font-weight: 600; }
  }
</style>
