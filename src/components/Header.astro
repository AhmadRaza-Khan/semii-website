---
import { SITE } from '../site';
const path = Astro.url.pathname;
const nav = [
  { href: '/docs', label: 'Docs' },
  { href: '/#features', label: 'Features' },
  { href: '/blog', label: 'Blog' },
  { href: '/changelog', label: 'Changelog' },
];
const active = (href: string) => href !== '/#features' && (path === href || path.startsWith(href + '/'));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="semii home">
      <img src="/icon-192.png" alt="" width="34" height="34" />
      <span>semii</span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle colour theme" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
      <a class="icon-btn" href={SITE.repo} aria-label="semii on GitHub" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
      </a>
      <a class="btn btn-primary get-started" href="/docs/getting-started">Get started</a>

      <details class="mobile-menu">
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <nav class="mobile-nav" aria-label="Mobile">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={SITE.repo} rel="noopener">GitHub</a>
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const current = () =>
    root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 28px; height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text); font-family: var(--font-display); font-size: 23px; font-weight: 700; letter-spacing: -0.01em; }
  .brand:hover { text-decoration: none; }
  .brand img { filter: drop-shadow(0 4px 10px rgba(242, 102, 28, .35)); }
  .nav { display: flex; gap: 26px; }
  .nav a { color: var(--text-soft); font-weight: 500; font-size: 15.5px; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--text); text-decoration: none; }
  .nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--ember); padding-bottom: 2px; }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .icon-btn {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 10px;
    color: var(--text-soft); background: transparent; border: 1px solid transparent; cursor: pointer;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--border); text-decoration: none; }
  .get-started { height: 40px; padding: 0 16px; font-size: 14.5px; margin-left: 6px; }
  .theme-toggle .sun { display: none; }
  :global(:root[data-theme='light']) .theme-toggle .sun { display: block; }
  :global(:root[data-theme='light']) .theme-toggle .moon { display: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .theme-toggle .sun { display: block; }
    :global(:root:not([data-theme='dark'])) .theme-toggle .moon { display: none; }
  }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-nav {
    position: absolute; right: 0; top: 50px; width: min(280px, calc(100vw - 32px));
    display: grid; gap: 4px; padding: 12px; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .mobile-nav a { padding: 10px 12px; border-radius: 8px; color: var(--text); font-weight: 500; }
  .mobile-nav a:hover { background: var(--surface-2); text-decoration: none; }
  .mobile-nav .btn { margin-top: 6px; color: #fff; }
  @media (max-width: 860px) {
    .nav, .get-started { display: none; }
    .mobile-menu { display: block; }
  }
</style>
