---
import { SITE } from '../site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Learn', links: [
    { href: '/docs/getting-started', label: 'Getting started' },
    { href: '/docs/cli', label: 'CLI reference' },
    { href: '/docs/deployment', label: 'Deployment' },
    { href: '/docs/packages/auth', label: 'Authentication' },
  ] },
  { title: 'Packages', links: [
    { href: '/docs/packages/web', label: 'web' },
    { href: '/docs/packages/db', label: 'db' },
    { href: '/docs/packages/testkit', label: 'testkit' },
    { href: '/docs/packages/config', label: 'config' },
  ] },
  { title: 'Project', links: [
    { href: SITE.repo, label: 'GitHub' },
    { href: SITE.pkg, label: 'pkg.go.dev' },
    { href: '/changelog', label: 'Changelog' },
    { href: '/blog', label: 'Blog' },
  ] },
];
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href="/"><img src="/icon-192.png" alt="" width="30" height="30" loading="lazy" /> semii</a>
      <p>{SITE.tagline}. Plain Go you own, generated in seconds.</p>
      <code class="install">{SITE.install}</code>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="container legal">
    <span>© {year} {SITE.author}. Released under the {SITE.license} License.</span>
    <span>Built with Astro. Go is a trademark of Google LLC.</span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); background: var(--bg-soft); padding: 56px 0 28px; margin-top: 40px; }
  .grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 36px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--text); font-family: var(--font-display); font-weight: 700; font-size: 20px; }
  .brand:hover { text-decoration: none; }
  .about p { color: var(--muted); margin: 12px 0; max-width: 34ch; }
  .install { display: inline-block; max-width: 100%; overflow-x: auto; white-space: nowrap; font-size: 12.5px; color: var(--text-soft); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; }
  h2 { font-family: var(--font-sans); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--text); margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  ul a { color: var(--muted); }
  ul a:hover { color: var(--text); }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13.5px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
