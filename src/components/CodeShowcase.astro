---
import { Code } from 'astro:components';

// Real code from a project generated by semii (examples/shop-postgres).
const tabs = [
  {
    id: 'routes', file: 'internal/product/routes.go',
    caption: 'Routes on the standard library router. Every route has a policy, or the app refuses to boot.',
    code: `package product

import (
	semiiauth "github.com/AhmadRaza-Khan/semii/auth"
	"github.com/AhmadRaza-Khan/semii/web"
)

// Register mounts the products endpoints under /products.
func Register(r *web.Router, h *Handler) {
	g := r.Group("/products").Require(semiiauth.Authenticated())
	g.HandleFunc("GET /", h.List)
	g.HandleFunc("POST /", h.Create)
	g.HandleFunc("GET /{id}", h.Get)
	g.HandleFunc("PATCH /{id}", h.Update)
	g.HandleFunc("DELETE /{id}", h.Delete)
}`,
  },
  {
    id: 'handler', file: 'internal/product/handler.go',
    caption: 'Handlers return errors; semii turns them into RFC 9457 problem responses.',
    code: `// List handles GET /products: newest first, cursor-paginated
// (?limit=&cursor=), filterable by sku.
func (h *Handler) List(w http.ResponseWriter, r *http.Request) error {
	f, err := web.DecodeQuery[ListFilter](r)
	if err != nil {
		return err
	}
	p, err := web.ParseCursor(r, 20, 100)
	if err != nil {
		return err
	}
	items, next, err := h.svc.List(r.Context(), f, p)
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, web.CursorPage[Product]{Data: items, NextCursor: next})
}

// Create handles POST /products.
func (h *Handler) Create(w http.ResponseWriter, r *http.Request) error {
	in, err := web.Decode[CreateInput](r) // 400, 413, 415 or 422 with field errors
	if err != nil {
		return err
	}
	out, err := h.svc.Create(r.Context(), in)
	if err != nil {
		return err
	}
	return web.Created(w, "/products/"+IDString(out.ID), out)
}`,
  },
  {
    id: 'test', file: 'internal/product/handler_test.go',
    caption: 'Tests come with every resource: a real database per test, factories and fluent assertions.',
    code: `func TestProductAPI(t *testing.T) {
	a, c := apptest.New(t)
	q := sqlc.New(a.DB)

	t.Run("requires authentication", func(t *testing.T) {
		c.GET("/products").Do().ExpectProblem(http.StatusUnauthorized, "unauthenticated")
	})
	c = c.As(&semiiauth.Principal{ID: "test-user", Kind: semiiauth.KindUser})

	t.Run("create rejects invalid input", func(t *testing.T) {
		c.POST("/products").JSON(map[string]any{}).Do().
			ExpectProblem(http.StatusUnprocessableEntity, "validation_failed").
			ExpectFieldError("name", "required")
	})

	t.Run("get", func(t *testing.T) {
		o := factory.Product(t, q)
		c.GET("/products/" + product.IDString(o.ID)).Do().
			ExpectStatus(http.StatusOK).
			ExpectJSON(map[string]any{"id": o.ID})
	})
}`,
  },
];
---

<div class="showcase">
  {tabs.map((t, i) => <input type="radio" name="code-tab" id={`tab-${t.id}`} checked={i === 0} class="sr-only" />)}
  <div class="tablist" role="presentation">
    {tabs.map((t) => <label for={`tab-${t.id}`}>{t.file.split('/').pop()}</label>)}
  </div>
  {tabs.map((t) => (
    <div class={`panel panel-${t.id}`}>
      <div class="file"><span>{t.file}</span></div>
      <Code code={t.code} lang="go" theme="github-dark-dimmed" />
      <p class="caption">{t.caption}</p>
    </div>
  ))}
</div>

<style>
  .showcase { border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--code-bg); box-shadow: var(--shadow); }
  .tablist { display: flex; gap: 2px; padding: 8px 8px 0; background: #17110d; border-bottom: 1px solid #2a2019; overflow-x: auto; }
  label { padding: 10px 16px; font-family: var(--font-mono); font-size: 13.5px; color: #a8988a; cursor: pointer; border-radius: 9px 9px 0 0; white-space: nowrap; }
  label:hover { color: #f0e2d4; }
  .panel { display: none; }
  .file { padding: 10px 20px 0; font-family: var(--font-mono); font-size: 12px; color: #7d6d60; }
  .panel :global(pre) { margin: 0; padding: 14px 20px 18px; font-size: 13.5px; line-height: 1.7; background: transparent !important; overflow-x: auto; }
  .caption { margin: 0; padding: 14px 20px; border-top: 1px solid #2a2019; color: #c9b8a8; font-size: 14.5px; background: #120d0a; }
  #tab-routes:checked ~ .panel-routes, #tab-handler:checked ~ .panel-handler, #tab-test:checked ~ .panel-test { display: block; }
  #tab-routes:checked ~ .tablist label[for='tab-routes'],
  #tab-handler:checked ~ .tablist label[for='tab-handler'],
  #tab-test:checked ~ .tablist label[for='tab-test'] { color: #fff; background: var(--code-bg); box-shadow: inset 0 2px 0 var(--ember); }
  #tab-routes:focus-visible ~ .tablist label[for='tab-routes'],
  #tab-handler:focus-visible ~ .tablist label[for='tab-handler'],
  #tab-test:focus-visible ~ .tablist label[for='tab-test'] { outline: 2px solid var(--ember); }
</style>
