---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="News, releases and guides from the semii project: building Go REST APIs faster with code generation.">
  <div class="container page">
    <span class="eyebrow">Blog</span>
    <h1>News from semii</h1>
    <div class="posts">
      {posts.map((p) => (
        <article class="card post">
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
          <p>{p.data.description}</p>
          <a class="more" href={`/blog/${p.id}`} aria-label={`Read: ${p.data.title}`}>Read more →</a>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .page { max-width: 860px; padding-top: 56px; padding-bottom: 40px; }
  h1 { font-size: clamp(36px, 5vw, 54px); margin: 8px 0 34px; }
  .posts { display: grid; gap: 18px; }
  .post { padding: 26px 28px; }
  time { color: var(--muted); font-size: 14px; }
  .post h2 { font-size: 26px; margin: 6px 0 10px; }
  .post h2 a { color: var(--text); }
  .post p { color: var(--text-soft); }
  .more { font-weight: 600; }
</style>
