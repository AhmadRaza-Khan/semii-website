---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  datePublished: date.toISOString(), url, mainEntityOfPage: url,
  author: { '@type': 'Person', name: post.data.author, url: 'https://github.com/AhmadRaza-Khan' },
  publisher: { '@type': 'Organization', name: 'semii', logo: { '@type': 'ImageObject', url: new URL('/icon.png', Astro.site).toString() } },
  image: new URL('/social-preview.png', Astro.site).toString(),
};
---

<Base title={post.data.title} description={post.data.description} type="article" published={date} jsonLd={jsonLd}>
  <article class="container post">
    <a class="back" href="/blog">← All posts</a>
    <h1>{post.data.title}</h1>
    <p class="byline">
      <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
      · by <a href="https://github.com/AhmadRaza-Khan" rel="author noopener">{post.data.author}</a>
    </p>
    <div class="prose"><Content /></div>
    <div class="card next">
      <p>Ready to try it?</p>
      <a class="btn btn-primary" href="/docs/getting-started">Get started with semii</a>
      <a class="btn btn-ghost" href={SITE.repo} rel="noopener">GitHub</a>
    </div>
  </article>
</Base>

<style>
  .post { max-width: 780px; padding-top: 48px; padding-bottom: 40px; }
  .back { font-size: 14.5px; }
  h1 { font-size: clamp(34px, 5vw, 52px); margin: 18px 0 12px; }
  .byline { color: var(--muted); margin-bottom: 36px; }
  .next { margin-top: 44px; padding: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .next p { margin: 0 auto 0 0; font-family: var(--font-display); font-size: 22px; color: var(--text); }
</style>
