---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Terminal from '../components/Terminal.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import { SITE } from '../site';

const features = [
  { icon: 'code', title: 'Code you own', text: 'semii writes plain, readable Go into your project. No runtime magic, no reflection-driven routing, nothing hidden. Edit any file; it is yours.' },
  { icon: 'route', title: 'net/http at the core', text: 'Routes, groups and middleware on the standard library ServeMux. Handlers return errors that become RFC 9457 problem responses.' },
  { icon: 'shield', title: 'Deny by default', text: 'Every route needs a policy — public, authenticated, a role or a scope. A route without one stops the app from booting.' },
  { icon: 'key', title: 'Auth built in', text: 'Sessions with CSRF protection, JWT with rotating refresh tokens, and API keys. argon2id passwords, rate limits and lockout included.' },
  { icon: 'db', title: 'Four databases', text: 'PostgreSQL, MySQL and SQLite with type-safe sqlc queries and migrations, or MongoDB. The same Go types and API on every one.' },
  { icon: 'test', title: 'Tests generated too', text: 'Every resource ships with HTTP tests, service tests, an in-memory fake and factories, running against real databases per test.' },
  { icon: 'bolt', title: 'Fast dev loop', text: 'semii dev rebuilds and restarts on save. semii routes lists every endpoint and its policy. semii doctor checks your setup.' },
  { icon: 'ship', title: 'Ready to ship', text: 'Distroless Dockerfile, docker compose, GitHub Actions with govulncheck, plus systemd, PM2 and Nginx configs for your servers.' },
  { icon: 'gauge', title: 'Lean and quick', text: 'A thin layer over net/http: 1–4% overhead with the standard middleware stack. Small dependencies, nothing you do not use.' },
];

const icons: Record<string, string> = {
  code: '<path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15"/>',
  route: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6H15a3.5 3.5 0 0 1 0 7H9a3.5 3.5 0 0 0 0 7h6.5"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8-8M16 7l2.5 2.5M14 9l2 2"/>',
  db: '<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/>',
  test: '<path d="M9 3.5h6M10 3.5v6L4.8 18.3A1.8 1.8 0 0 0 6.4 21h11.2a1.8 1.8 0 0 0 1.6-2.7L14 9.5v-6"/><path d="M7 15h10"/>',
  bolt: '<path d="M13 2.5 5 13.5h6l-1 8 8-11h-6z"/>',
  ship: '<path d="M3 15.5h18l-2.2 4.5H5.2zM6 15.5V9h12v6.5M12 9V3.5M9 6.5h6"/>',
  gauge: '<path d="M4 17a8 8 0 1 1 16 0"/><path d="m12 17 4-5"/><circle cx="12" cy="17" r="1.3"/>',
};

// Small leaves drifting down from the big one: start point (% of the
// artwork), fall time, delay, size, sideways drift and spin.
const fallingLeaves = [
  { x: 14, y: 52, dur: 10.5, delay: 0, size: 44, drift: -70, spin: 240 },
  { x: 58, y: 66, dur: 11, delay: 1.4, size: 42, drift: 55, spin: 260 },
  { x: 34, y: 62, dur: 10, delay: 2.8, size: 49, drift: -45, spin: 180 },
  { x: 86, y: 54, dur: 12, delay: 4.2, size: 34, drift: 80, spin: -300 },
  { x: 24, y: 58, dur: 11.5, delay: 5.6, size: 38, drift: 60, spin: -220 },
  { x: 70, y: 60, dur: 9.5, delay: 7, size: 53, drift: -65, spin: -200 },
  { x: 46, y: 64, dur: 12.5, delay: 8.4, size: 36, drift: 70, spin: 280 },
  { x: 90, y: 58, dur: 11, delay: 9.8, size: 40, drift: -50, spin: 230 },
  { x: 8, y: 48, dur: 12, delay: 11.2, size: 34, drift: -80, spin: -260 },
  { x: 64, y: 62, dur: 10, delay: 12.4, size: 46, drift: 45, spin: 250 },
];

const databases = [
  { name: 'PostgreSQL', detail: 'pgx and sqlc, UUID or bigint ids, goose migrations' },
  { name: 'MySQL', detail: 'database/sql with sqlc, the same types as Postgres' },
  { name: 'SQLite', detail: 'pure Go, no CGO, perfect for small services and tests' },
  { name: 'MongoDB', detail: 'official driver v2, transactions on replica sets' },
];

const steps = [
  { n: '1', title: 'Install', cmd: 'go install github.com/AhmadRaza-Khan/semii/cmd/semii@latest' },
  { n: '2', title: 'Create your API', cmd: 'semii new shop --db postgres --auth jwt' },
  { n: '3', title: 'Generate resources', cmd: 'semii g resource Order customer:ref:Customer total:decimal:min=0' },
  { n: '4', title: 'Run and ship', cmd: 'semii dev   # then docker build, or the systemd / PM2 configs' },
];

const faqs = [
  { q: 'What is semii?', a: 'semii is a scaffolding framework for building REST APIs in Go. Its CLI generates a complete project — routing, validation, authentication, database access, migrations, tests and deployment files — and a set of small Go packages supports the generated code.' },
  { q: 'Is semii a runtime framework like Rails?', a: 'It gives you the Rails speed, but not the runtime magic. Conventions are delivered through code generation: the output is ordinary Go that you read, edit and own. The semii packages it imports are thin libraries on top of net/http.' },
  { q: 'Which Go version do I need?', a: `Go ${SITE.goVersion} or newer. semii supports the two latest stable Go releases.` },
  { q: 'Do I need Docker?', a: 'Only to run PostgreSQL, MySQL or MongoDB locally and for the database tests. SQLite projects need no Docker at all.' },
  { q: 'Can I stop using semii later?', a: 'Yes. The generated code lives in your repository and keeps working without the CLI. You can keep or replace the small semii packages it imports.' },
  { q: 'Is semii free?', a: 'Yes. semii is open source under the MIT License.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'semii',
    url: Astro.site?.toString(),
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'semii',
    description: SITE.description,
    codeRepository: SITE.repo,
    programmingLanguage: 'Go',
    license: 'https://opensource.org/licenses/MIT',
    version: SITE.version,
    author: { '@type': 'Person', name: SITE.author, url: 'https://github.com/AhmadRaza-Khan' },
    image: new URL('/logo.png', Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="semii — Rails-speed scaffolding for Go APIs"
  fullTitle
  description="semii is a Go API framework and code generator: create production-ready REST APIs with auth, validation, migrations, tests and deployment in minutes — plain Go on net/http."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="ember-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <a class="pill" href="/blog/introducing-semii">
          <span class="dot" aria-hidden="true"></span> semii {SITE.version} is out — read the announcement
        </a>
        <h1>Rails-speed scaffolding <span class="grad-text">for Go APIs</span></h1>
        <p class="lead">
          Generate a production-ready Go REST API — routes, validation, authentication, database,
          migrations, tests and deployment — in one command. Plain Go code you own, built on{' '}
          <code>net/http</code>. No runtime magic.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-ghost" href={SITE.repo} rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
            Star on GitHub
          </a>
        </div>
        <CopyCommand command={SITE.install} />
        <p class="meta">Go {SITE.goVersion}+ · MIT licensed · PostgreSQL, MySQL, SQLite, MongoDB</p>
      </div>
      <div class="hero-art">
        <img src="/logo.png" width="800" height="428" alt="The semii logo: a red-orange autumn leaf with the word Semii burned into it" fetchpriority="high" />
        <div class="falling" aria-hidden="true">
          {fallingLeaves.map((l) => (
            <span class="fall" style={`--x:${l.x}%;--y:${l.y}%;--dur:${l.dur}s;--delay:${l.delay}s;--size:${l.size}px;--drift:${l.drift}px;--spin:${l.spin}deg`}>
              <span class="sway"><i></i></span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section demo" aria-labelledby="demo-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">From zero to API</span>
        <h2 id="demo-title">A complete Go API in under a minute</h2>
        <p>One command creates the project. One more adds a fully tested resource with its migration, handlers, validation and routes.</p>
      </div>
      <Terminal />
      <ul class="stats" aria-label="What semii generates">
        <li><strong>48</strong><span>files from <code>semii new</code></span></li>
        <li><strong>~3,300</strong><span>lines of plain Go</span></li>
        <li><strong>4</strong><span>databases supported</span></li>
        <li><strong>3</strong><span>auth strategies</span></li>
        <li><strong>1–4%</strong><span>router overhead vs net/http</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why semii</span>
        <h2 id="features-title">Conventions, delivered as code</h2>
        <p>Everything a production Go backend needs, generated the same way every time — so your team writes features, not boilerplate.</p>
      </div>
      <div class="features">
        {features.map((f) => (
          <article class="card feature">
            <svg class="ficon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section code-section" aria-labelledby="code-title">
    <div class="container split">
      <div class="split-copy">
        <span class="eyebrow">Readable by design</span>
        <h2 id="code-title">Generated code that looks hand-written</h2>
        <p>
          semii does not hide your API behind annotations or reflection. Each resource is a small,
          idiomatic Go package: a model, input types with validation, a repository with a database
          implementation and an in-memory fake, a service, HTTP handlers, routes and tests.
        </p>
        <ul class="checks">
          <li>Standard <code>http.Handler</code> everywhere — use any Go middleware</li>
          <li>Type-safe SQL with sqlc; no ORM</li>
          <li>Cursor and offset pagination, filters and PATCH semantics</li>
          <li>RFC 9457 errors with field-level validation messages</li>
        </ul>
        <a class="btn btn-ghost" href="/docs/packages/web">Explore the web package</a>
      </div>
      <CodeShowcase />
    </div>
  </section>

  <section class="section" aria-labelledby="db-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Your database, your call</span>
        <h2 id="db-title">One framework, four databases</h2>
        <p>Pick with <code>--db</code> when you create the project. Handlers, services and tests look the same on every database; only the repository layer changes.</p>
      </div>
      <div class="dbs">
        {databases.map((d) => (
          <div class="card db">
            <h3>{d.name}</h3>
            <p>{d.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section security" aria-labelledby="sec-title">
    <div class="container split reverse">
      <div class="card sec-card">
        <ul class="checks">
          <li>Pinned JWT algorithm; <code>alg=none</code> and key confusion rejected</li>
          <li>Refresh token reuse revokes the whole token family</li>
          <li>Session fixation impossible; CSRF checks on every cookie request</li>
          <li>No account enumeration, in responses or in timing</li>
          <li>Single-use, expiring reset links; a reset signs out every device</li>
          <li>argon2id hashing, login rate limits and progressive lockout</li>
          <li>Security headers, body limits and <code>no-store</code> on credentials</li>
        </ul>
      </div>
      <div class="split-copy">
        <span class="eyebrow">Secure by default</span>
        <h2 id="sec-title">Authentication you would be proud to audit</h2>
        <p>
          <code>semii g auth</code> adds sign-up, login, email verification, password reset and API
          keys, using sessions, JWT or both. The flows were pentested end to end against a generated
          app, and the checks ship as tests in your project.
        </p>
        <a class="btn btn-ghost" href="/docs/packages/auth">Read the auth guide</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Get going</span>
        <h2 id="steps-title">Four steps to production</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="card step">
            <span class="num" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <code>{s.cmd}</code>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">Questions, answered</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="card">
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta" aria-labelledby="cta-title">
    <div class="container cta-box">
      <img src="/icon-192.png" alt="" width="72" height="72" loading="lazy" />
      <h2 id="cta-title">Build your next Go API with semii</h2>
      <p>Open source, MIT licensed, and ready for production today.</p>
      <div class="ctas center">
        <a class="btn btn-primary" href="/docs/getting-started">Read the docs</a>
        <a class="btn btn-ghost" href={SITE.repo} rel="noopener">View on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding: 72px 0 40px; overflow: hidden; }
  .ember-bg {
    position: absolute; inset: -20% -10% auto; height: 760px; pointer-events: none;
    background:
      radial-gradient(42% 46% at 72% 40%, rgba(242, 102, 28, .22), transparent 70%),
      radial-gradient(30% 36% at 88% 18%, rgba(200, 35, 26, .18), transparent 70%),
      radial-gradient(28% 30% at 15% 10%, rgba(246, 178, 59, .08), transparent 70%);
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--border-strong); background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--text-soft); font-size: 14px; font-weight: 500; margin-bottom: 26px;
  }
  .pill:hover { border-color: var(--ember); text-decoration: none; color: var(--text); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ember); box-shadow: 0 0 0 4px rgba(242, 102, 28, .2); }
  h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.03; letter-spacing: -0.03em; margin-bottom: 22px; }
  .lead { font-size: clamp(17px, 1.6vw, 20px); color: var(--text-soft); max-width: 58ch; margin-bottom: 30px; }
  .lead code { font-size: .9em; color: var(--text); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 26px; }
  .ctas.center { justify-content: center; }
  .meta { color: var(--muted); font-size: 14px; margin-top: 14px; }
  .hero-art img { width: 100%; max-width: 640px; margin-left: auto; filter: drop-shadow(0 40px 60px rgba(200, 50, 10, .45)); transform: rotate(-4deg);
    animation: float 11s ease-in-out infinite, ember-glow 5.5s ease-in-out infinite alternate; }
  /* A leaf in a light breeze: slow figure-of-eight drift, a little sway
     and a gentle 3D rustle; the ember glow underneath breathes. */
  @keyframes float {
    0%   { transform: perspective(1000px) rotate(-4deg) rotateY(0deg) rotateX(0deg) translate(0, 0); }
    20%  { transform: perspective(1000px) rotate(-1.5deg) rotateY(7deg) rotateX(3deg) translate(8px, -9px); }
    40%  { transform: perspective(1000px) rotate(-3deg) rotateY(2deg) rotateX(-2deg) translate(2px, -16px); }
    60%  { transform: perspective(1000px) rotate(-6.5deg) rotateY(-6deg) rotateX(2deg) translate(-8px, -8px); }
    80%  { transform: perspective(1000px) rotate(-5deg) rotateY(-2deg) rotateX(-3deg) translate(-3px, -2px); }
    100% { transform: perspective(1000px) rotate(-4deg) rotateY(0deg) rotateX(0deg) translate(0, 0); }
  }
  @keyframes ember-glow {
    from { filter: drop-shadow(0 40px 60px rgba(200, 50, 10, .38)); }
    to   { filter: drop-shadow(0 44px 70px rgba(235, 80, 15, .6)); }
  }

  /* Small leaves falling from the big one, fading out as they go. */
  .hero-art { position: relative; }
  .falling { position: absolute; inset: 0; pointer-events: none; }
  .fall {
    position: absolute; left: var(--x); top: var(--y); opacity: 0;
    animation: leaf-fall var(--dur) linear var(--delay) infinite;
  }
  .sway { display: block; animation: leaf-sway calc(var(--dur) / 3) ease-in-out var(--delay) infinite alternate; }
  .sway i {
    display: block; width: var(--size); height: var(--size);
    background: url(/icon-192.png) center / contain no-repeat;
    filter: drop-shadow(0 6px 8px rgba(160, 40, 10, .35));
    animation: leaf-spin var(--dur) linear var(--delay) infinite;
  }
  @keyframes leaf-fall {
    0% { transform: translate(0, 0); opacity: 0; }
    8% { opacity: .95; }
    55% { opacity: .7; }
    100% { transform: translate(var(--drift), 240px); opacity: 0; }
  }
  @keyframes leaf-sway { from { transform: translateX(-14px); } to { transform: translateX(14px); } }
  @keyframes leaf-spin { from { transform: rotate(0deg); } to { transform: rotate(var(--spin)); } }
  @media (prefers-reduced-motion: reduce) { .falling { display: none; } }

  .stats { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .stats li { text-align: center; padding: 18px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .stats strong { display: block; font-family: var(--font-display); font-size: 34px; line-height: 1.1; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats span { color: var(--muted); font-size: 14px; }

  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feature { padding: 26px; transition: border-color .2s, transform .2s; }
  .feature:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .ficon { color: var(--ember); margin-bottom: 14px; }
  .feature h3 { font-size: 21px; }
  .feature p { color: var(--muted); margin: 0; font-size: 15.5px; }

  .code-section { background: var(--bg-soft); border-block: 1px solid var(--border); }
  .split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; align-items: center; }
  .split.reverse { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .hero-copy, .split-copy { min-width: 0; }
  .hero-copy { position: relative; z-index: 1; }
  .split-copy h2 { font-size: clamp(28px, 3.6vw, 42px); margin-top: 10px; }
  .split-copy p { color: var(--text-soft); font-size: 17px; }
  .checks { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 12px; }
  .checks li { position: relative; padding-left: 30px; color: var(--text-soft); }
  .checks li::before { content: ''; position: absolute; left: 0; top: 5px; width: 18px; height: 18px; border-radius: 50%; background: var(--grad); -webkit-mask: radial-gradient(circle, #000 55%, transparent 56%); }
  .checks li::after { content: ''; position: absolute; left: 6px; top: 9px; width: 6px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(40deg); }
  .checks code { font-size: .86em; color: var(--text); }

  .dbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .db { padding: 24px; border-top: 3px solid var(--ember); }
  .db h3 { font-size: 22px; }
  .db p { color: var(--muted); margin: 0; font-size: 15px; }

  .sec-card { padding: 30px; background: linear-gradient(160deg, var(--surface), var(--bg-soft)); }
  .sec-card .checks { margin: 0; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step { padding: 24px; position: relative; display: flex; flex-direction: column; }
  .num { font-family: var(--font-display); font-size: 40px; line-height: 1; font-weight: 700; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 12px; }
  .step h3 { font-size: 20px; }
  .step code { margin-top: auto; font-size: 12.5px; color: var(--text-soft); background: var(--code-bg); border: 1px solid var(--border); padding: 10px 12px; border-radius: 8px; overflow-wrap: anywhere; color: #eadccf; }

  .faq-wrap { max-width: 860px; }
  .faq { display: grid; gap: 12px; }
