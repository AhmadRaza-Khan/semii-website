---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist. Find the semii docs, blog and changelog from here." noindex>
  <div class="container nf">
    <img src="/icon-192.png" alt="" width="110" height="110" />
    <h1>This leaf has blown away</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <div class="links">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-ghost" href="/docs">Documentation</a>
    </div>
  </div>
</Base>

<style>
  .nf { text-align: center; padding: 110px 0 80px; }
  img { margin: 0 auto 22px; transform: rotate(-14deg); filter: drop-shadow(0 14px 30px rgba(242, 102, 28, .4)); }
  h1 { font-size: clamp(32px, 5vw, 48px); }
  p { color: var(--muted); font-size: 18px; }
  .links { display: flex; gap: 12px; justify-content: center; margin-top: 24px; }
</style>
